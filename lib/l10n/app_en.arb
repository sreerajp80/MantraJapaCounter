  "tutorialStep13Desc": "The ⋮ menu has History, About, Settings, Finish & start new, Reset session and Reset counter.",
  "@tutorialStep13Desc": {
    "description": "Tutorial step 13 description"
  },
  "tutorialStep13Tip": "Reset session clears only this sitting. Reset counter deletes all history of the counter.",
  "@tutorialStep13Tip": {
    "description": "Tutorial step 13 tip"
  },
  "tutorialStep14Title": "108 beads = 1 mala",
  "@tutorialStep14Title": {
    "description": "Tutorial step 14 title"
  },
  "tutorialStep14Desc": "Every 108 counts make one mala. The circle fills bead by bead and starts again after 108.",
  "@tutorialStep14Desc": {
    "description": "Tutorial step 14 description"
  },
  "tutorialStep14Tip": "115 counts = 1 mala and 7 counts. Extra counts are never lost.",
  "@tutorialStep14Tip": {
    "description": "Tutorial step 14 tip"
  },
  "tutorialStep15Title": "Reach your goals",
  "@tutorialStep15Title": {
    "description": "Tutorial step 15 title"
  },
  "tutorialStep15Desc": "When you reach the daily goal, a tone plays, the phone vibrates and a notification appears. The lifetime goal has its own tone, notification and a gold trophy.",
  "@tutorialStep15Desc": {
    "description": "Tutorial step 15 description"
  },
  "tutorialStep15Tip": "Turn these on or off in Settings → Sound & Haptics.",
  "@tutorialStep15Tip": {
    "description": "Tutorial step 15 tip"
  },
  "tutorialStep16Title": "Meru pause",
  "@tutorialStep16Title": {
    "description": "Tutorial step 16 title"
  },
  "tutorialStep16Desc": "Turn it on in Settings → Display & Stillness. After each mala the app pauses for 3, 5 or 10 seconds, so you can rest and breathe.",
  "@tutorialStep16Desc": {
    "description": "Tutorial step 16 description"
  },
  "tutorialStep16Tip": "Taps during the pause are not counted, just as the Meru bead is never crossed.",
  "@tutorialStep16Tip": {
    "description": "Tutorial step 16 tip"
  },
  "tutorialStep17Title": "Gentle pacing hint",
  "@tutorialStep17Title": {
    "description": "Tutorial step 17 title"
  },
  "tutorialStep17Desc": "If you tap faster than about 3 times a second, the circle glows amber and a short reminder appears.",
  "@tutorialStep17Desc": {
    "description": "Tutorial step 17 description"
  },
  "tutorialStep17Tip": "Every tap still counts. You can turn the hint off in Settings → Display & Stillness.",
  "@tutorialStep17Tip": {
    "description": "Tutorial step 17 tip"
  },
  "tutorialStep18Title": "History",
  "@tutorialStep18Title": {
    "description": "Tutorial step 18 title"
  },
  "tutorialStep18Desc": "Open History from the counting menu or the long-press menu. Sittings are grouped by day, with time, length, count and malas.",
  "@tutorialStep18Desc": {
    "description": "Tutorial step 18 description"
  },
  "tutorialStep18Tip": "Tap the delete icon on a sitting to remove it. Totals update at once.",
  "@tutorialStep18Tip": {
    "description": "Tutorial step 18 tip"
  },
  "tutorialStep19Title": "Sadhana Flow",
  "@tutorialStep19Title": {
    "description": "Tutorial step 19 title"
  },
  "tutorialStep19Desc": "The calendar in History shows the last 16 weeks. Days with practice glow like a lamp. A brighter glow means more chanting.",
  "@tutorialStep19Desc": {
    "description": "Tutorial step 19 description"
  },
  "tutorialStep19Tip": "There are no streaks and no missed-day marks. Every day you return is welcome.",
  "@tutorialStep19Tip": {
    "description": "Tutorial step 19 tip"
  },
  "tutorialStep20Title": "Counter statistics",
  "@tutorialStep20Title": {
    "description": "Tutorial step 20 title"
  },
  "tutorialStep20Desc": "Choose Counter info (long-press menu) or About (counting menu) to see progress rings and all details of the counter.",
  "@tutorialStep20Desc": {
    "description": "Tutorial step 20 description"
  },
  "tutorialStep20Tip": "The average chants per day is worked out from the start date you set.",
  "@tutorialStep20Tip": {
    "description": "Tutorial step 20 tip"
  },
  "tutorialStep21Title": "Sounds",
  "@tutorialStep21Title": {
    "description": "Tutorial step 21 title"
  },
  "tutorialStep21Desc": "In Settings → Sound & Haptics choose the mala sound, the daily goal tone and the lifetime goal tone. Pick a built-in sound, a phone ringtone, or your own audio file.",
  "@tutorialStep21Desc": {
    "description": "Tutorial step 21 description"
  },
  "tutorialStep21Tip": "Tap Preview to hear the tone before you chant.",
  "@tutorialStep21Tip": {
    "description": "Tutorial step 21 tip"
  },
  "tutorialStep22Title": "Vibration and notifications",
  "@tutorialStep22Title": {
    "description": "Tutorial step 22 title"
  },
  "tutorialStep22Desc": "Vibration marks each mala, each goal and each undo. Goal notifications appear in the status bar.",
  "@tutorialStep22Desc": {
    "description": "Tutorial step 22 description"
  },
  "tutorialStep22Tip": "Sounds play through the alarm channel, so you hear them even when the phone is on silent.",
  "@tutorialStep22Tip": {
    "description": "Tutorial step 22 tip"
  },
  "tutorialStep23Title": "Display and stillness",
  "@tutorialStep23Title": {
    "description": "Tutorial step 23 title"
  },
  "tutorialStep23Desc": "In Settings → Display & Stillness set the brightness, turn on Dimmed chanting mode, or silence calls and alerts with Do Not Disturb.",
  "@tutorialStep23Desc": {
    "description": "Tutorial step 23 description"
  },
  "tutorialStep23Tip": "Do Not Disturb needs a one-time permission. It is turned off again when you leave the counting screen.",
  "@tutorialStep23Tip": {
    "description": "Tutorial step 23 tip"
  },
  "tutorialStep24Title": "Appearance",
  "@tutorialStep24Title": {
    "description": "Tutorial step 24 title"
  },
  "tutorialStep24Desc": "Settings → Appearance shows the temple colours and fonts used in the app.",
  "@tutorialStep24Desc": {
    "description": "Tutorial step 24 description"
  },
  "tutorialStep24Tip": "The app always stays upright (portrait), so you can count with one hand.",
  "@tutorialStep24Tip": {
    "description": "Tutorial step 24 tip"
  },
  "tutorialStep25Title": "Back up to a file",
  "@tutorialStep25Title": {
    "description": "Tutorial step 25 title"
  },
  "tutorialStep25Desc": "Use Settings → Data Backup & Optical Sync → Export, or Import / Export in the home menu. All counters and history are saved to one file, and the share sheet opens.",
  "@tutorialStep25Desc": {
    "description": "Tutorial step 25 description"
  },
  "tutorialStep25Tip": "You can lock the file with a passphrase (AES-256-GCM). A lost passphrase cannot be recovered.",
  "@tutorialStep25Tip": {
    "description": "Tutorial step 25 tip"
  },
  "tutorialStep26Title": "Restore from a file",
  "@tutorialStep26Title": {
    "description": "Tutorial step 26 title"
  },
  "tutorialStep26Desc": "Choose Import and pick your backup file. Enter the passphrase if the file is encrypted.",
  "@tutorialStep26Desc": {
    "description": "Tutorial step 26 description"
  },
  "tutorialStep26Tip": "Import replaces ALL current data on this phone. Export first if you want to keep it.",
  "@tutorialStep26Tip": {
    "description": "Tutorial step 26 tip"
  },
  "tutorialStep27Title": "Phone-to-phone sync",
  "@tutorialStep27Title": {
    "description": "Tutorial step 27 title"
  },
  "tutorialStep27Desc": "On the old phone choose Optical Sync (Send) and pick the counters. On the new phone choose Optical Sync (Receive) and point the camera at the moving QR code.",
  "@tutorialStep27Desc": {
    "description": "Tutorial step 27 description"
  },
  "tutorialStep27Tip": "No internet, Bluetooth or cable is used. Chosen counters are added; other counters on the receiving phone are kept.",
  "@tutorialStep27Tip": {
    "description": "Tutorial step 27 tip"
  },
  "tutorialStep28Title": "Clear all data",
  "@tutorialStep28Title": {
    "description": "Tutorial step 28 title"
  },
  "tutorialStep28Desc": "Settings → Data Backup & Optical Sync → Clear all data deletes every counter and all history.",
  "@tutorialStep28Desc": {
    "description": "Tutorial step 28 description"
  },
  "tutorialStep28Tip": "Make a backup first. This cannot be undone.",
  "@tutorialStep28Tip": {
    "description": "Tutorial step 28 tip"
  },
  "tutorialStep29Title": "Fully offline and private",
  "@tutorialStep29Title": {
    "description": "Tutorial step 29 title"
  },
  "tutorialStep29Desc": "The app has no internet permission, no ads, no tracking and no account. Your practice stays on your phone.",
  "@tutorialStep29Desc": {
    "description": "Tutorial step 29 description"
  },
  "tutorialStep29Tip": "Android cloud backup is off for this app, so use Export or Optical Sync to keep a copy.",
  "@tutorialStep29Tip": {
    "description": "Tutorial step 29 tip"
  },
  "tutorialStep30Title": "Permissions",
  "@tutorialStep30Title": {
    "description": "Tutorial step 30 title"
  },
  "tutorialStep30Desc": "The camera is used only to scan sync codes. Notifications show goal messages. Vibration and audio give feedback. Do Not Disturb access is asked only if you turn it on.",
  "@tutorialStep30Desc": {
    "description": "Tutorial step 30 description"
  },
  "tutorialStep30Tip": "See every permission and why it is used in Settings → Permissions.",
  "@tutorialStep30Tip": {
    "description": "Tutorial step 30 tip"
  },
  "helpCountersIntro": "The home screen lists all your counters. Each counter is one mantra or practice, with its own goals and history.",
