  "helpFaqQ5Answer": "Each tap counts on the day you make it, by your phone's clock. The daily goal starts again at midnight.",
  "@helpFaqQ5Answer": {
    "description": "Help FAQ: answer 5"
  },
  "helpFaqQ6Title": "What is the difference between Reset session and Reset counter?",
  "@helpFaqQ6Title": {
    "description": "Help FAQ: question 6"
  },
  "helpFaqQ6Answer": "Reset session throws away only the current sitting. Reset counter deletes all history of that counter and cannot be undone.",
  "@helpFaqQ6Answer": {
    "description": "Help FAQ: answer 6"
  },
  "helpFaqQ7Title": "Why did the mala sound not play?",
  "@helpFaqQ7Title": {
    "description": "Help FAQ: question 7"
  },
  "helpFaqQ7Answer": "Check that Enable mala sound is on. If the same tap also reached a goal, only the goal tone plays.",
  "@helpFaqQ7Answer": {
    "description": "Help FAQ: answer 7"
  },
  "helpFaqQ8Title": "Why do sounds play when my phone is on silent?",
  "@helpFaqQ8Title": {
    "description": "Help FAQ: question 8"
  },
  "helpFaqQ8Answer": "Completion sounds use the alarm channel so you do not miss them. Turn off the sounds in Settings → Sound & Haptics if you want silence.",
  "@helpFaqQ8Answer": {
    "description": "Help FAQ: answer 8"
  },
  "helpFaqQ9Title": "I forgot my backup passphrase. What can I do?",
  "@helpFaqQ9Title": {
    "description": "Help FAQ: question 9"
  },
  "helpFaqQ9Answer": "The passphrase cannot be recovered, and that file cannot be opened. Make a new backup from a phone that still has your data.",
  "@helpFaqQ9Answer": {
    "description": "Help FAQ: answer 9"
  },
  "helpFaqQ10Title": "Will import remove my current counters?",
  "@helpFaqQ10Title": {
    "description": "Help FAQ: question 10"
  },
  "helpFaqQ10Answer": "Importing a backup file replaces all current data. Optical Sync is different: it only adds or updates the counters you choose.",
  "@helpFaqQ10Answer": {
    "description": "Help FAQ: answer 10"
  },
  "helpFaqQ11Title": "Optical Sync scanning is slow. What helps?",
  "@helpFaqQ11Title": {
    "description": "Help FAQ: question 11"
  },
  "helpFaqQ11Answer": "Hold the phone steady 15–25 cm away, tap to focus, avoid glare, and raise the sender's brightness. Try a lower speed such as 8 frames per second.",
  "@helpFaqQ11Answer": {
    "description": "Help FAQ: answer 11"
  },
  "helpFaqQ12Title": "Can I move my data to a new phone?",
  "@helpFaqQ12Title": {
    "description": "Help FAQ: question 12"
  },
  "helpFaqQ12Answer": "Yes. Use Optical Sync with both phones side by side, or export a backup file and import it on the new phone.",
  "@helpFaqQ12Answer": {
    "description": "Help FAQ: answer 12"
  },
  "helpFaqQ13Title": "Why is the app fully offline?",
  "@helpFaqQ13Title": {
    "description": "Help FAQ: question 13"
  },
  "helpFaqQ13Answer": "Japa is personal and sacred. Staying offline keeps your practice private, saves battery, and removes distractions.",
  "@helpFaqQ13Answer": {
    "description": "Help FAQ: answer 13"
  },
  "helpFaqQ14Title": "Is my data shared with anyone?",
  "@helpFaqQ14Title": {
    "description": "Help FAQ: question 14"
  },
  "helpFaqQ14Answer": "No. Your data never leaves your phone unless you export it or send it with Optical Sync yourself.",
  "@helpFaqQ14Answer": {
    "description": "Help FAQ: answer 14"
  }
}
