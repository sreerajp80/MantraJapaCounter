    "description": "Help FAQ: question 2"
  },
  "helpFaqQ2Answer": "Put two fingers on the mala circle and slide them left or right. Each swipe removes one step.",
  "@helpFaqQ2Answer": {
    "description": "Help FAQ: answer 2"
  },
  "helpFaqQ3Title": "Why does my counter not open?",
