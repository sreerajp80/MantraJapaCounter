  "helpCountingIntro": "The counting screen is made for quiet focus. You do not need to look at it while you chant.",
  "@helpCountingIntro": {
    "description": "Help counting guide: intro text"
  },
  "helpCountingTapSection": "How to count",
  "@helpCountingTapSection": {
    "description": "Help counting guide: Tap section title"
  },
  "helpCountingTapBold1": "Tap inside the circle:",
  "@helpCountingTapBold1": {
    "description": "Help counting guide: Tap bullet 1 bold label"
  },
  "helpCountingTapBullet1": "Only taps inside the mala circle are counted. Taps outside it are ignored, so a stray touch does not add a count.",
  "@helpCountingTapBullet1": {
    "description": "Help counting guide: Tap bullet 1 text"
  },
  "helpCountingTapBold2": "Increment step:",
  "@helpCountingTapBold2": {
    "description": "Help counting guide: Tap bullet 2 bold label"
  },
  "helpCountingTapBullet2": "Each tap adds the counter's step (1 by default). Change it by editing the counter.",
  "@helpCountingTapBullet2": {
    "description": "Help counting guide: Tap bullet 2 text"
  },
  "helpCountingTapBold3": "Quiet taps:",
  "@helpCountingTapBold3": {
    "description": "Help counting guide: Tap bullet 3 bold label"
  },
  "helpCountingTapBullet3": "Taps do not vibrate. You feel a vibration on each full mala, on goals and on undo, if vibration is on.",
  "@helpCountingTapBullet3": {
    "description": "Help counting guide: Tap bullet 3 text"
  },
  "helpCountingUndoSection": "Undoing a count",
  "@helpCountingUndoSection": {
    "description": "Help counting guide: Undo section title"
  },
  "helpCountingUndoBold1": "Two-finger swipe:",
  "@helpCountingUndoBold1": {
    "description": "Help counting guide: Undo bullet 1 bold label"
  },
  "helpCountingUndoBullet1": "Place two fingers on the circle and slide them left or right. One swipe removes one step, and the phone vibrates once.",
  "@helpCountingUndoBullet1": {
    "description": "Help counting guide: Undo bullet 1 text"
  },
  "helpCountingUndoBold2": "Back to zero:",
  "@helpCountingUndoBold2": {
    "description": "Help counting guide: Undo bullet 2 bold label"
  },
  "helpCountingUndoBullet2": "If the session count goes back to 0, the sitting is cleared and nothing is added to history.",
  "@helpCountingUndoBullet2": {
    "description": "Help counting guide: Undo bullet 2 text"
  },
  "helpMalaIntro": "A traditional japa mala has 108 beads. The app counts in rounds of 108 and shows your goals on every card.",
  "@helpMalaIntro": {
    "description": "Help mala and goals guide: intro text"
  },
  "helpMalaBeadsSection": "108 beads",
  "@helpMalaBeadsSection": {
    "description": "Help mala and goals guide: Beads section title"
  },
  "helpMalaBeadsBold1": "1 mala = 108 counts:",
  "@helpMalaBeadsBold1": {
    "description": "Help mala and goals guide: Beads bullet 1 bold label"
  },
  "helpMalaBeadsBullet1": "Every 108 counts make one full mala. The circle on the counting screen fills bead by bead and starts again after 108.",
  "@helpMalaBeadsBullet1": {
    "description": "Help mala and goals guide: Beads bullet 1 text"
  },
  "helpMalaBeadsBold2": "Extra counts:",
  "@helpMalaBeadsBold2": {
    "description": "Help mala and goals guide: Beads bullet 2 bold label"
  },
  "helpMalaBeadsBullet2": "Counts past a full mala are kept and shown. For example, 115 counts = 1 mala and 7 counts.",
  "@helpMalaBeadsBullet2": {
    "description": "Help mala and goals guide: Beads bullet 2 text"
  },
  "helpMalaBeadsBold3": "Bigger steps:",
  "@helpMalaBeadsBold3": {
    "description": "Help mala and goals guide: Beads bullet 3 bold label"
  },
  "helpMalaBeadsBullet3": "If your step is more than 1, each tap moves several beads at once. Malas are still worked out from the total count.",
  "@helpMalaBeadsBullet3": {
    "description": "Help mala and goals guide: Beads bullet 3 text"
  },
  "helpMalaGoalsSection": "Daily and lifetime goals",
  "@helpMalaGoalsSection": {
    "description": "Help mala and goals guide: Goals section title"
  },
  "helpMalaGoalsBold1": "Daily goal:",
  "@helpMalaGoalsBold1": {
    "description": "Help mala and goals guide: Goals bullet 1 bold label"
  },
  "helpMalaGoalsBullet1": "The number of chants you want to offer each day (0 = no daily goal). It starts again from 0 at midnight, by your phone's clock.",
  "@helpMalaGoalsBullet1": {
    "description": "Help mala and goals guide: Goals bullet 1 text"
  },
  "helpMalaGoalsBold2": "Lifetime goal (vow):",
  "@helpMalaGoalsBold2": {
    "description": "Help mala and goals guide: Goals bullet 2 bold label"
  },
  "helpMalaGoalsBullet2": "Your long-term target, for example 1,00,000 chants (0 = no lifetime goal). The daily goal cannot be more than it.",
  "@helpMalaGoalsBullet2": {
    "description": "Help mala and goals guide: Goals bullet 2 text"
  },
  "helpOpticalIntro": "Optical Sync moves your counters and history from one phone to another using only the screen and the camera. No internet, Wi-Fi, Bluetooth or cable is needed.",
  "@helpOpticalIntro": {
    "description": "Help optical sync guide: intro text"
  },
  "helpOpticalHowSection": "How to transfer",
  "@helpOpticalHowSection": {
    "description": "Help optical sync guide: How section title"
  },
  "helpOpticalHowBold1": "Sender phone:",
  "@helpOpticalHowBold1": {
    "description": "Help optical sync guide: How bullet 1 bold label"
  },
  "helpOpticalHowBullet1": "Settings → Data Backup & Optical Sync → Optical Air-Gap Sync (Send). Choose the counters to send. A moving QR code starts to play.",
  "@helpOpticalHowBullet1": {
    "description": "Help optical sync guide: How bullet 1 text"
  },
  "helpOpticalHowBold2": "Receiver phone:",
  "@helpOpticalHowBold2": {
    "description": "Help optical sync guide: How bullet 2 bold label"
  },
  "helpOpticalHowBullet2": "Open Optical Air-Gap Sync (Receive), allow the camera, and point it at the sender's screen.",
  "@helpOpticalHowBullet2": {
    "description": "Help optical sync guide: How bullet 2 text"
  },
  "helpOpticalHowBold3": "Preview:",
  "@helpOpticalHowBold3": {
    "description": "Help optical sync guide: How bullet 3 bold label"
  },
  "helpOpticalHowBullet3": "When all parts arrive, a preview shows the counters and sessions. Choose the counters to keep and tap the restore button.",
  "@helpOpticalHowBullet3": {
    "description": "Help optical sync guide: How bullet 3 text"
  },
  "helpOpticalTipsSection": "Tips for fast scanning",
  "@helpOpticalTipsSection": {
    "description": "Help optical sync guide: Tips section title"
  },
  "helpOpticalTipsBold1": "Distance:",
  "@helpOpticalTipsBold1": {
    "description": "Help optical sync guide: Tips bullet 1 bold label"
  },
  "helpOpticalTipsBullet1": "Hold the receiving phone steady, about 15–25 cm from the sender's screen, with the code inside the guide box.",
  "@helpOpticalTipsBullet1": {
    "description": "Help optical sync guide: Tips bullet 1 text"
  },
  "helpOpticalTipsBold2": "Glare:",
  "@helpOpticalTipsBold2": {
    "description": "Help optical sync guide: Tips bullet 2 bold label"
  },
  "helpOpticalTipsBullet2": "Avoid bright reflections on the sender's screen.",
  "@helpOpticalTipsBullet2": {
    "description": "Help optical sync guide: Tips bullet 2 text"
  },
  "helpOpticalTipsBold3": "Missed frames:",
  "@helpOpticalTipsBold3": {
    "description": "Help optical sync guide: Tips bullet 3 bold label"
  },
  "helpOpticalTipsBullet3": "Missed frames are fine. The stream keeps repeating with extra mixed frames, so missing parts are rebuilt.",
  "@helpOpticalTipsBullet3": {
    "description": "Help optical sync guide: Tips bullet 3 text"
  },
  "helpAudioIntro": "Sounds and vibration mark the moments that matter: each full mala and each goal. Set them in Settings → Sound & Haptics.",
  "@helpAudioIntro": {
    "description": "Help sound and vibration guide: intro text"
  },
  "helpAudioVibrationSection": "Vibration",
  "@helpAudioVibrationSection": {
    "description": "Help sound and vibration guide: Vibration section title"
  },
  "helpAudioVibrationBold1": "When it vibrates:",
  "@helpAudioVibrationBold1": {
    "description": "Help sound and vibration guide: Vibration bullet 1 bold label"
  },
  "helpAudioVibrationBullet1": "One pulse on each full mala, three pulses when a goal is reached, and a short tap when you undo.",
  "@helpAudioVibrationBullet1": {
    "description": "Help sound and vibration guide: Vibration bullet 1 text"
  },
  "helpAudioVibrationBold2": "Turn off:",
  "@helpAudioVibrationBold2": {
    "description": "Help sound and vibration guide: Vibration bullet 2 bold label"
  },
